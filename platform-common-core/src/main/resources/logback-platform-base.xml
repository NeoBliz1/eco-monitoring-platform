<included>
    <springProfile name="dev">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!-- Includes bold colors, short thread identifiers, and clear trace IDs -->
                <pattern>%d{HH:mm:ss.SSS} [%boldYellow(%thread)] %boldGreen(%-5level) %cyan(%logger{15}) - %msg%n</pattern>
            </encoder>
        </appender>

        <!-- Testcontainers logs -->
        <logger name="org.testcontainers" level="INFO"/>
        <logger name="tc" level="INFO"/>
        <logger name="com.github.dockerjava" level="WARN"/>
        <logger name="org.testcontainers.containers.output" level="INFO"/>

        <!-- Application logs -->
        <logger name="me.neobliz1.ecomonitoring" level="DEBUG"/>

        <!-- 📡 Core Spring Boot Application Lifecycle Tracking -->
        <logger name="org.springframework.boot" level="INFO"/>

        <!-- ⚙️ Spring Property Binding and Context Environment Resolvers -->
        <logger name="org.springframework.core.env" level="INFO"/>
        <logger name="org.springframework.beans.factory" level="INFO"/>
        <logger name="org.springframework.cache" level="TRACE"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
    <springProfile name="prod">
        <property name="TCP_DESTINATION" value="${LOGSTASH_TCP_DESTINATION}"/>
        <springProperty scope="context" name="APP_NAME" source="spring.application.name"
                        defaultValue="unknown-spring-service"/>
        <appender name="STRUCTURED_JSON" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
            <destination>${TCP_DESTINATION}</destination>
            <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
                <providers>
                    <timestamp/>
                    <version/>
                    <logLevel/>
                    <threadName/>
                    <loggerName/>
                    <message/>
                    <mdc/> <!-- Automatically captures OpenTelemetry Trace IDs and Span IDs! -->
                    <pattern>
                        <pattern>
                            {
                            "service_name": "${APP_NAME}"
                            }
                        </pattern>
                    </pattern>
                    <stackTrace/>
                </providers>
            </encoder>
        </appender>
        <appender name="ASYNC_STRUCTURED_JSON" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="STRUCTURED_JSON"/>
            <queueSize>1024</queueSize>
            <discardingThreshold>0</discardingThreshold>
            <neverBlock>true</neverBlock>
        </appender>
        <logger name="org.springframework" level="WARN"/>
        <logger name="org.apache.kafka" level="WARN"/>
        <logger name="me.neobliz1.ecomonitoring" level="INFO"/>
        <root level="INFO">
            <appender-ref ref="ASYNC_STRUCTURED_JSON"/>
        </root>
    </springProfile>
</included>
