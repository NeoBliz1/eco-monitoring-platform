OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4317
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=grpc
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_BSP_MAX_QUEUE_SIZE=8192
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=1024
OTEL_BSP_SCHEDULE_DELAY=1000

# Spring Application Configuration
SPRING_INGESTION_APPLICATION_NAME=eco-monitoring-ingestion
SPRING_ANALYSIS_APPLICATION_NAME=eco-monitoring-analysis
SPRING_HISTORY_APPLICATION_NAME=eco-monitoring-history

# Server Configuration
INGESTION_APPLICATION_SERVER_PORT=8080
ANALYSIS_APPLICATION_SERVER_PORT=8081
HISTORY_APPLICATION_SERVER_PORT=8082
HISTORY_APPLICATION_GRPC_PORT=8192
SERVER_HOST=localhost

# Vector sidecar Configuration
VECTOR_SERVICE_NAME=vector-sidecar

# Consul Configuration
SPRING_CLOUD_CONSUL_HOST=localhost
SPRING_CLOUD_CONSUL_PORT=8500

# Kafka Configuration
KAFKA_SERVICE_NAME=kafka
KAFKA_CLIENT=client

#Redis Configuration
SPRING_DATA_REDIS_SERVICE_NAME=redis-cache

#Postgres Configuration
SPRING_DATA_DB_NAME=eco_platform_history_service_db
SPRING_DATA_SERVICE_NAME=pg-db
POSTGRES_DB_SCHEMA=history_service

LOGSTASH_TCP_DESTINATION=localhost:6001