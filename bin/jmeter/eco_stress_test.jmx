        <JSR223Sampler guiclass="TestBeanGui" testclass="JSR223Sampler" testname="Fetch Analytical Data Stream" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename">analyze_spatial.groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script"></stringProp>
